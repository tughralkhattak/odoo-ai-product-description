<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_ai_pd" model="ir.ui.view">
        <field name="name">product.template.form.ai.product.description</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_ai_generate_description" type="object"
                        class="oe_stat_button" icon="fa-magic"
                        help="Generate a product description with AI">
                    <div class="o_stat_info">
                        <span class="o_stat_text">AI</span>
                        <span class="o_stat_text">Description</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
