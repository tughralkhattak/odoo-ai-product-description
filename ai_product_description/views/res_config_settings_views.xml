<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_pd" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.ai.product.description</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Product Description"
                     string="AI Product Description"
                     name="ai_product_description"
                     logo="/ai_product_description/static/description/icon.png">
                    <block title="AI Provider"
                           name="ai_pd_provider_block"
                           help="Groq, Google Gemini and OpenRouter all offer free API keys. Ollama runs locally with no key.">
                        <setting string="Provider"
                                 help="Pick your AI provider.">
                            <field name="ai_pd_provider"/>
                        </setting>
                        <setting string="API Key"
                                 help="Paste your key here. Not required for Ollama (local).">
                            <field name="ai_pd_api_key" password="True"
                                   placeholder="sk-... / gsk_... / your key"/>
                        </setting>
                        <setting string="Model"
                                 help="Leave empty to use a good default for the selected provider.">
                            <field name="ai_pd_model" placeholder="auto"/>
                        </setting>
                        <setting string="API Base URL"
                                 help="Advanced. Override only if you use a custom endpoint or proxy.">
                            <field name="ai_pd_base_url" placeholder="auto"/>
                        </setting>
                        <setting string="Creativity"
                                 help="0 = precise and factual, 1 = more creative.">
                            <field name="ai_pd_temperature"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
